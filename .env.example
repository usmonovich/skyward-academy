# Copy to .env.local for local development. Never commit real values of private keys.
# Both Supabase values below are public by design (Project Settings > API). Do NOT put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: rename the app, or point the tutor at your own proxy.
VITE_APP_NAME=
VITE_TUTOR_ENDPOINT=
